       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"\:8ba1\:7b97\:5f39\:6027\:80fd\:91cf", 
         RowBox[{
         "\:ff08", "\:7b80\:5316\:7684Frank\:5f39\:6027", "\:ff09"}]}], 
        "*)"}], 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "cylinders", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", 
            RowBox[{"i", "+", "1"}]}], ",", 
           RowBox[{"j", "\[LessEqual]", 
            RowBox[{"Length", "[", "cylinders", "]"}]}], ",", 
           RowBox[{"j", "++"}], ",", 
           RowBox[{
            RowBox[{"dr", "=", 
             RowBox[{
              RowBox[{"centers", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "-", 
              RowBox[{"centers", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"r", "=", 
             RowBox[{"Norm", "[", "dr", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 

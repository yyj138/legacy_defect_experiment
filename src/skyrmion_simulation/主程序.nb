                RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<StdY\>\"", "\[Rule]", 
             RowBox[{"StandardDeviation", "[", 
              RowBox[{"centers", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<StdZ\>\"", "\[Rule]", 
             RowBox[{"StandardDeviation", "[", 
              RowBox[{"centers", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}]}], "}"}]}]}],
         "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
  "(*", "\:8ba1\:7b97\:53d6\:5411\:5e8f\:53c2\:6570", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"calculateOrderParameter", "[", "cylinders_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "orientations", ",", "n", ",", "Q", ",", "eigenvalues", ",", "S"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"orientations", "=", 
        RowBox[{"extractOrientations", "[", "cylinders", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "orientations", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "\:8ba1\:7b97\:5e8f\:53c2\:6570\:5f20\:91cf", "*)"}], 
       RowBox[{"Q", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"3", "*", 
               RowBox[{"orientations", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "i"}], "]"}], "]"}], "*", 
               RowBox[{"orientations", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "j"}], "]"}], "]"}]}], "-", 
              RowBox[{"KroneckerDelta", "[", 
               RowBox[{"i", ",", "j"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "n"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "3"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "\:8ba1\:7b97\:7279\:5f81\:503c", "*)"}], 
       RowBox[{"eigenvalues", "=", 
        RowBox[{"Eigenvalues", "[", "Q", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"S", "=", 
        RowBox[{"Max", "[", "eigenvalues", "]"}]}], ";", 
       RowBox[{
       "(*", "\:6700\:5927\:7279\:5f81\:503c\:5373\:4e3a\:5e8f\:53c2\:6570", 
        "*)"}], 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<OrderParameter\>\"", "\[Rule]", "S"}], ",", 
         RowBox[{"\"\<OrderParameterTensor\>\"", "\[Rule]", "Q"}], ",", 
         RowBox[{"\"\<Eigenvalues\>\"", "\[Rule]", "eigenvalues"}], ",", 
         RowBox[{"\"\<Alignment\>\"", "\[Rule]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"S", ">", "0.7"}], ",", "\"\<Well Aligned\>\"", ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"S", ">", "0.3"}], ",", "\"\<Partially Aligned\>\"", 
              ",", "\"\<Disordered\>\""}], "]"}]}], "]"}]}]}], "|>"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
  "(*", "\:8ba1\:7b97\:5bc6\:5ea6\:5206\:5e03", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"calculateDensityProfile", "[", 
     RowBox[{"cylinders_List", ",", 
      RowBox[{"bins_:", " ", "20"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "centers", ",", "xCoords", ",", "yCoords", ",", "zCoords", ",", 
        "xHist", ",", "yHist", ",", "zHist"}], "}"}], ",", 
      RowBox[{
       RowBox[{"centers", "=", 
        RowBox[{"extractCenters", "[", "cylinders", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xCoords", "=", 
        RowBox[{"centers", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yCoords", "=", 
        RowBox[{"centers", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zCoords", "=", 
        RowBox[{"centers", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xHist", "=", 
        RowBox[{"HistogramList", "[", 
         RowBox[{"xCoords", ",", "bins"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yHist", "=", 
        RowBox[{"HistogramList", "[", 
         RowBox[{"yCoords", ",", "bins"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"zHist", "=", 
        RowBox[{"HistogramList", "[", 
         RowBox[{"zCoords", ",", "bins"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<XProfile\>\"", "\[Rule]", "xHist"}], ",", 
         RowBox[{"\"\<YProfile\>\"", "\[Rule]", "yHist"}], ",", 
         RowBox[{"\"\<ZProfile\>\"", "\[Rule]", "zHist"}], ",", 
         RowBox[{"\"\<PeakDensity\>\"", "\[Rule]", 
          RowBox[{"Max", "[", 
           RowBox[{"Last", "/@", 
            RowBox[{"{", 
             RowBox[{"xHist", ",", "yHist", ",", "zHist"}], "}"}]}], 
           "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{
  "(*", "\:5b8c\:6574\:7684\:7ed3\:6784\:5206\:6790\:62a5\:544a", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"analyzeFullStructure", "[", 
     RowBox[{"cylinders_List", ",", 
      RowBox[{"params_:", " ", 
       RowBox[{"<|", "|>"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "topology", ",", "energy", ",", "structure", ",", "order", ",", 
        "density"}], "}"}], ",", 
      RowBox[{
       RowBox[{"topology", "=", 
        RowBox[{"analyzeTopology", "[", "cylinders", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"energy", "=", 
        RowBox[{"calculateEnergy", "[", 
         RowBox[{"cylinders", ",", "params"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"structure", "=", 
        RowBox[{"analyzeDefectStructure", "[", "cylinders", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"order", "=", 
        RowBox[{"calculateOrderParameter", "[", "cylinders", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"density", "=", 
        RowBox[{"calculateDensityProfile", "[", "cylinders", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Summary\>\"", "\[Rule]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<TotalMolecules\>\"", "\[Rule]", 
             RowBox[{"topology", "[", "\"\<TotalMolecules\>\"", "]"}]}], ",", 
            RowBox[{"\"\<DefectType\>\"", "\[Rule]", 
             RowBox[{"structure", "[", "\"\<DefectType\>\"", "]"}]}], ",", 
            RowBox[{"\"\<OrderParameter\>\"", "\[Rule]", 
             RowBox[{"order", "[", "\"\<OrderParameter\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Alignment\>\"", "\[Rule]", 
             RowBox[{"order", "[", "\"\<Alignment\>\"", "]"}]}], ",", 
            RowBox[{"\"\<TotalEnergy\>\"", "\[Rule]", 
             RowBox[{"energy", "[", "\"\<TotalEnergy\>\"", "]"}]}]}], 
           "|>"}]}], ",", 
         RowBox[{"\"\<Detailed\>\"", "\[Rule]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Topology\>\"", "\[Rule]", "topology"}], ",", 
            RowBox[{"\"\<Energy\>\"", "\[Rule]", "energy"}], ",", 
            RowBox[{"\"\<Structure\>\"", "\[Rule]", "structure"}], ",", 
            RowBox[{"\"\<Order\>\"", "\[Rule]", "order"}], ",", 
            RowBox[{"\"\<Density\>\"", "\[Rule]", "density"}]}], "|>"}]}]}], 
        "|>"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"End", "[", "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"EndPackage", "[", "]"}]}], "Input",ExpressionUUID->"151fdb24-f11d-\
4738-aa5c-61416e447b74"],


             RowBox[{
              RowBox[{"ArcTan", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], "/@", 
             "orientations"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", "\:8ba1\:7b97\:7ed5\:6570", "*)"}], 
           RowBox[{"windingNumber", "=", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{"Mean", "[", 
               RowBox[{"Differences", "[", "angles", "]"}], "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "Pi"}], ")"}]}], "]"}]}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 

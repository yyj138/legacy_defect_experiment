                    RowBox[{"dotProduct", "^", "2"}]}], ")"}], "/", 
                  RowBox[{"r", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"energy", "+=", "interactionEnergy"}]}]}], "]"}]}]}], 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 

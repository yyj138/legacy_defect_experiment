                  RowBox[{"[", "j", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"interactionEnergy", "=", 
                RowBox[{"elasticConstant", "*", 
                 RowBox[{
                  RowBox[{"(", 
